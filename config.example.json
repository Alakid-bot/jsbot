{
    "token": "string (Discord bot token)",
    "guilds": {
        "guildId1": {
            "serverType": "string (Main server | Sub server)",
            "commandsDeployed": "boolean",
            "enabledCommands": [
                "string (Discord app command names to register for this guild; omit this field to enable all loaded commands)"
            ],
            "moderationLogThreadId": "string (Discord channel ID)",
            "threadLogThreadId": "string (Discord channel ID)",
            "opinionMailThreadId": "string (Discord channel ID)",
            "punishmentConfirmationChannelId": "string (Discord channel ID for punishment confirmations)",
            "AdministratorRoleIds": [
                "string (Discord role IDs)"
            ],
            "ModeratorRoleIds": [
                "string (Discord role IDs)"
            ],
            "eventsCategoryId": "string (Discord category ID)",
            "automation": {
                "mode": "string (analysis | cleanup | disabled)",
                "threshold": "number (default: 960)",
                "logThreadId": "string (Discord channel ID)",
                "whitelistedThreads": [
                    "string (Discord thread IDs)"
                ]
            },
            "roleApplication": {
                "logThreadId": "string | null",
                "creatorRoleId": "string | null",
                "volunteerRoleId": "string | null",
                "senatorRoleId": "string | null",
                "appealDebateRoleId": "string | null",
                "QAerRoleId": "string | null",
                "senatorRoleForumId": "string | null",
                "WarnedRoleId": "string | null"
            },
            "fastgpt": {
                "enabled": "boolean",
                "endpoints": [
                    {
                        "provider": "string (fastgpt | openai-compatible | custom)",
                        "url": "string",
                        "key": "string",
                        "model": "string | optional, required for openai-compatible endpoints",
                        "contentFormat": "string (auto | text | multimodal)"
                    }
                ],
                "endpointNames": {
                    "domainKey": "string (display name)"
                }
            },
            "courtSystem": {
                "enabled": "boolean",
                "courtChannelId": "string | null",
                "motionChannelId": "string | null",
                "debateChannelId": "string | null",
                "appealDuration": "number (default: 259200000)",
                "summitDuration": "number (default: 604800000)",
                "requiredSupports": "number (default: 20)",
                "debateTagId": "string | null",
                "motionTagId": "string | null",
                "voteDuration": "number (default: 86400000)"
            },
            "monitor": {
                "enabled": "boolean",
                "roleMonitorCategoryId": "string | null",
                "monitorChannelId": "string | null",
                "monitoredRoleId": "string | null",
                "roleDisplayName": "string (default: '角色')"
            },
            "selfServiceRoles": {
                "enabled": "boolean",
                "groups": [
                    {
                        "id": "string (group identifier for button customId)",
                        "label": "string (display name for users)",
                        "description": "string | null",
                        "emoji": "string | null",
                        "roleId": "string (Discord role ID)",
                        "mode": "string (toggle | grant | remove, default: toggle)",
                        "activityRequirement": {
                            "minMessages": "number | optional (minimum messages in last 7 days before granting)"
                        }
                    }
                ]
            },
            "messageStats": {
                "enabled": "boolean",
                "queryAllowUserIds": [
                    "string (Discord user IDs allowed to query anyone's stats)"
                ],
                "allowSelfQuery": "boolean (default: true)",
                "trackBots": "boolean (default: false)"
            },
            "autoDeleteChannels": [
                "string (Discord channel IDs where all messages should be auto-deleted)"
            ]
        }
    }
}
