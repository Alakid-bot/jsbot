# Zeabur service environment variables for this Discord bot.
# Do NOT commit real secrets. Copy values into Zeabur Dashboard > Service > Environment Variables.

# Required. Full content of config.json.
# Recommended: base64 encode the JSON locally and set JSBOT_CONFIG_JSON_BASE64 instead of raw JSON.
JSBOT_CONFIG_JSON_BASE64=BASE64_ENCODED_CONFIG_JSON

# Alternative to JSBOT_CONFIG_JSON_BASE64. Keep valid JSON in one value.
# JSBOT_CONFIG_JSON={"token":"YOUR_DISCORD_BOT_TOKEN","guilds":{}}

# Optional. Full content of pg.config.json if you use PostgreSQL-backed features.
# If you deploy this bot with zeabur-template.yaml, PostgreSQL variables are injected
# automatically and you usually do not need to set JSBOT_PG_CONFIG_JSON_BASE64.
JSBOT_PG_CONFIG_JSON_BASE64=BASE64_ENCODED_PG_CONFIG_JSON

# Alternative to JSBOT_PG_CONFIG_JSON_BASE64.
# JSBOT_PG_CONFIG_JSON={"host":"HOST","port":5432,"database":"DB","user":"USER","password":"PASSWORD","logging":false}

# Zeabur PostgreSQL service variables. zeabur-template.yaml maps exposed
# PostgreSQL variables into the ZEABUR_POSTGRES_* names below.
# POSTGRES_HOST=${POSTGRES_HOST}
# POSTGRES_PORT=${POSTGRES_PORT}
# POSTGRES_DATABASE=${POSTGRES_DATABASE}
# POSTGRES_USERNAME=${POSTGRES_USERNAME}
# POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
# ZEABUR_POSTGRES_HOST=${POSTGRES_HOST}
# ZEABUR_POSTGRES_PORT=${POSTGRES_PORT}
# ZEABUR_POSTGRES_DATABASE=${POSTGRES_DATABASE}
# ZEABUR_POSTGRES_USERNAME=${POSTGRES_USERNAME}
# ZEABUR_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Optional PostgreSQL pool tuning used when pg.config.json is generated from POSTGRES_* variables.
JSBOT_PG_POOL_MAX=20
JSBOT_PG_IDLE_TIMEOUT_MILLIS=30000
JSBOT_PG_CONNECTION_TIMEOUT_MILLIS=5000
JSBOT_PG_LOGGING=false

# Optional. Initial content of data/messageIds.json.
# If omitted, the container creates data/messageIds.json as {}.
# JSBOT_MESSAGE_IDS_JSON_BASE64=BASE64_ENCODED_MESSAGE_IDS_JSON

NODE_ENV=production
